<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Grimoire.ViewModels"
             xmlns:l="using:Grimoire.Services"
             xmlns:s="using:Grimoire.Services"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             x:Class="Grimoire.Views.ItemDetailView"
             x:DataType="vm:ItemDetailViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">

        <!-- Top bar with close (X) in the top-left -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid ColumnDefinitions="Auto,*">
                <Button Classes="icon" Command="{Binding CloseCommand}"
                        ToolTip.Tip="{l:Tr Detail_Close}" AutomationProperties.Name="{l:Tr Detail_Close}">
                    <PathIcon Data="{StaticResource IconClose}" Width="20" Height="20" />
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Item.Name}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="760" Margin="16,16,16,32" Spacing="16">

                <!-- Hero image (or generated cover art) -->
                <Border Height="300" CornerRadius="6" ClipToBounds="True"
                        Background="{Binding Item.CoverBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                    <Panel>
                        <TextBlock Text="{Binding Item.Initials}" FontSize="96" FontWeight="Black"
                                   Foreground="#E6FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding HeroImage}" Stretch="UniformToFill" />
                    </Panel>
                </Border>

                <!-- Title + creator -->
                <StackPanel Spacing="8">
                    <SelectableTextBlock Classes="h1" Text="{Binding Item.Name}" TextWrapping="Wrap"
                                         FontSize="28" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" ClipToBounds="True"
                                Background="{StaticResource AccentBrush}"
                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                            <Panel>
                                <TextBlock Text="{Binding Item.AuthorInitial}" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding AuthorAvatar}" Stretch="UniformToFill" />
                            </Panel>
                        </Border>
                        <TextBlock Text="{Binding ByAuthor}" VerticalAlignment="Center" FontSize="15" />
                    </StackPanel>
                </StackPanel>

                <!-- Loading / error -->
                <StackPanel IsVisible="{Binding IsLoading}" Spacing="6">
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Classes="muted" Text="{l:Tr Detail_Loading}" />
                </StackPanel>
                <StackPanel IsVisible="{Binding HasError}" Spacing="8">
                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" />
                    <Button Classes="outline" Command="{Binding LoadCommand}" Content="{l:Tr Lib_Retry}" />
                </StackPanel>

                <!-- Details -->
                <Border Classes="section" IsVisible="{Binding HasFields}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:Tr Detail_Details}" />
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailRow">
                                    <Grid ColumnDefinitions="140,*" Margin="0,4">
                                        <TextBlock Classes="muted" Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Versions -->
                <Border Classes="section" IsVisible="{Binding HasVersions}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="h2" Text="{l:Tr Detail_Versions}" />
                        <ItemsControl ItemsSource="{Binding Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="s:VersionInfo">
                                    <Border BorderBrush="{DynamicResource SubtleOutlineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Price}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Tags -->
                <StackPanel Spacing="8" IsVisible="{Binding HasTags}">
                    <TextBlock Classes="h2" Text="{l:Tr Detail_Tags}" />
                    <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="chip">
                                    <TextBlock Text="{Binding}" FontSize="13" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Bottom-most action: download when available, otherwise the store page -->
                <StackPanel Spacing="8" Margin="0,8,0,0" IsVisible="{Binding !IsLoading}">
                    <HyperlinkButton Classes="primary" HorizontalAlignment="Stretch"
                                     NavigateUri="{Binding DownloadUrl}" IsVisible="{Binding HasDownload}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconDownload}" Width="18" Height="18" Foreground="{StaticResource OnAccentBrush}" />
                            <TextBlock Text="{l:Tr Detail_Download}" Foreground="{StaticResource OnAccentBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    <HyperlinkButton Classes="primary" HorizontalAlignment="Stretch"
                                     NavigateUri="{Binding StoreUrl}" IsVisible="{Binding ShowNoDownloadNote}"
                                     IsEnabled="{Binding HasStoreUrl}">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <PathIcon Data="{StaticResource IconOpen}" Width="18" Height="18" Foreground="{StaticResource OnAccentBrush}" />
                            <TextBlock Text="{l:Tr Detail_OpenOnJinxxy}" Foreground="{StaticResource OnAccentBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Text="{l:Tr Detail_NoDownload}" IsVisible="{Binding ShowNoDownloadNote}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
