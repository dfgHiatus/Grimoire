<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Grimoire.ViewModels"
             xmlns:l="using:Grimoire.Services"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             x:Class="Grimoire.Views.LoginView"
             x:DataType="vm:LoginViewModel">
    <ScrollViewer>
        <StackPanel MaxWidth="440" Margin="24,40" Spacing="16" VerticalAlignment="Center">

            <Border Width="64" Height="64" CornerRadius="8" HorizontalAlignment="Left"
                    Background="{StaticResource AccentBrush}"
                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                <PathIcon Data="{StaticResource IconBook}" Width="32" Height="32" Foreground="{StaticResource OnAccentBrush}" />
            </Border>

            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="{l:Tr Login_Title}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{l:Tr Login_Subtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Classes="section">
                <StackPanel Spacing="10">
                    <TextBlock Text="{l:Tr Login_ApiKey}" FontWeight="SemiBold" />
                    <TextBox x:Name="ApiKeyBox"
                             Text="{Binding ApiKey}"
                             PasswordChar="●"
                             Classes="revealPasswordButton"
                             PlaceholderText="{l:Tr Login_ApiKeyPlaceholder}"
                             IsEnabled="{Binding !IsBusy}"
                             AutomationProperties.Name="{l:Tr Login_ApiKey}" />
                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Text="{l:Tr Login_ApiKeyHelp}" />
                    <HyperlinkButton Padding="0" NavigateUri="{Binding HelpUrl}" Content="{l:Tr Login_HowToGetKey}" />

                    <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />

                    <Button Classes="primary" HorizontalAlignment="Stretch" IsDefault="True" Margin="0,4,0,0"
                            Command="{Binding SignInCommand}"
                            AutomationProperties.Name="{l:Tr Login_Button}">
                        <Panel>
                            <TextBlock Text="{l:Tr Login_Button}" IsVisible="{Binding !IsBusy}" />
                            <TextBlock Text="{l:Tr Login_Busy}" IsVisible="{Binding IsBusy}" />
                        </Panel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="6">
                <Button Classes="icon" Padding="0" CornerRadius="0" Command="{Binding ToggleWhyNoPasswordCommand}">
                    <TextBlock Text="{l:Tr Login_WhyNoPassword}" TextDecorations="Underline" TextWrapping="Wrap" />
                </Button>
                <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap"
                           Text="{l:Tr Login_WhyNoPasswordBody}" IsVisible="{Binding ShowWhyNoPassword}" />
            </StackPanel>

            <Button Classes="outline" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding UseDemoCommand}" Content="{l:Tr Login_Demo}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
